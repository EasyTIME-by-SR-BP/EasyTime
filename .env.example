# App (lokal)
APP_PORT=8080

# Produktion (nginx reverse proxy)
HTTP_PORT=80
HTTPS_PORT=445

# Database (Docker: DB_HOST=db)
DB_DRIVER=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=easytime
DB_USERNAME=easytime
DB_PASSWORD=easytime

# MariaDB container bootstrap (must match DB_* user/database)
MYSQL_ROOT_PASSWORD=rootsecret

# Migration source (services.sqlite)
# SQLITE_SOURCE_PATH=database/database.sqlite

# Demo-Admin nach Legacy-Import (Personal-ID bleibt A000)
# LEGACY_DEMO_ADMIN_EMAIL=admin@easytime.local

# Server SSH (für pnpm prod — Passwort nur lokal in .env, nie committen)
SERVER_HOST=85.255.151.186
SERVER_SSH_PORT=22333
SERVER_SSH_USER=easytime
SERVER_SSH_PASSWORD=
SERVER_TUNNEL_LOCAL_PORT=9080
SERVER_TUNNEL_REMOTE_HOST=127.0.0.1
SERVER_TUNNEL_REMOTE_PORT=80

# App URL (für E-Mail-Links in Produktion, z. B. https://easytime.example.at)
APP_URL=http://localhost:8080

# E-Mail (PHPMailer) — standardmäßig deaktiviert
MAIL_ENABLED=false
MAIL_FROM_ADDRESS=noreply@easytime.local
MAIL_FROM_NAME=EasyTime
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_SMTP_AUTH=true
# Wie mailtest.php auf dem Server (pop.easydrivers.at / Port 25)
MAIL_AUTH_TYPE=LOGIN
MAIL_SMTP_INSECURE=true
MAIL_SMTP_AUTO_TLS=true
# Aufgaben (Urlaub, Passwort-Hilfe, …) per E-Mail
MAIL_NOTIFY_TASKS=true
# Status-Infos an Mitarbeiter (genehmigt, abgelehnt, …)
MAIL_NOTIFY_INFO=true

# Lokaler Mail-Test mit Docker-Profil "mail":
# docker compose --profile mail up -d
# MAIL_ENABLED=true
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# MAIL_ENCRYPTION=none
# MAIL_SMTP_AUTH=false
# Mailpit UI: http://localhost:8025
