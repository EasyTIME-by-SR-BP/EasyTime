# App (lokal)
APP_PORT=8080

# Produktion (nginx reverse proxy)
HTTP_PORT=80
HTTPS_PORT=445

# Database (Docker: DB_HOST=db)
DB_DRIVER=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=easytime
DB_USERNAME=easytime
DB_PASSWORD=easytime

# MariaDB container bootstrap (must match DB_* user/database)
MYSQL_ROOT_PASSWORD=rootsecret

# Migration source (host path; mounted in compose migrate profile)
# SQLITE_SOURCE_PATH=database/database.sqlite

# Server SSH (für pnpm prod — Passwort nur lokal in .env, nie committen)
SERVER_HOST=85.255.151.186
SERVER_SSH_PORT=22333
SERVER_SSH_USER=easytime
SERVER_SSH_PASSWORD=
SERVER_TUNNEL_LOCAL_PORT=9080
SERVER_TUNNEL_REMOTE_HOST=127.0.0.1
SERVER_TUNNEL_REMOTE_PORT=80
